{
  "version": 1,
  "org": "Volontariapp",
  "repos": [
    {
      "name": ".github",
      "role": "org-profile",
      "description": "Profil GitHub de l'organisation"
    },
    {
      "name": "docs",
      "role": "docs",
      "description": "Documentation d'architecture C4, ADR et guides"
    },
    {
      "name": "ci-tools",
      "role": "tooling",
      "description": "Workflows GitHub Actions partages et docker-compose local"
    },
    {
      "name": "changelog-checker",
      "role": "tooling",
      "description": "Validation automatisee des versions et changelogs"
    },
    {
      "name": "deploy",
      "role": "infra",
      "description": "GitOps Kubernetes (ArgoCD)"
    },
    {
      "name": "proto-registry",
      "role": "contracts",
      "description": "Registre Protobuf (SSOT gRPC)"
    },
    {
      "name": "npm-packages",
      "role": "library",
      "description": "Monorepo des packages @volontariapp/*",
      "install": true,
      "build": true
    },
    {
      "name": "api-gateway",
      "role": "gateway",
      "description": "Passerelle HTTP/REST",
      "install": true
    },
    {
      "name": "ws-service",
      "role": "gateway",
      "description": "Passerelle WebSocket",
      "install": true
    },
    {
      "name": "ms-user",
      "role": "microservice",
      "description": "Identite et profils",
      "install": true
    },
    {
      "name": "ms-social",
      "role": "microservice",
      "description": "Relations sociales (Neo4j)",
      "install": true
    },
    {
      "name": "ms-post",
      "role": "microservice",
      "description": "Publications et commentaires",
      "install": true
    },
    {
      "name": "ms-event",
      "role": "microservice",
      "description": "Evenements et participations",
      "install": true
    },
    {
      "name": "ms-storage",
      "role": "microservice",
      "description": "Medias et stockage objet",
      "install": true
    },
    {
      "name": "ms-ranking",
      "role": "microservice",
      "description": "Classements",
      "install": true
    },
    {
      "name": "outbox-runners",
      "role": "runner-group",
      "description": "Daemons outbox PostgreSQL vers Redis Streams"
    },
    {
      "name": "workers-runners",
      "role": "runner-group",
      "description": "Consommateurs BullMQ"
    },
    {
      "name": "post-processors-runner",
      "role": "runner-group",
      "description": "Consommateurs Redis Streams"
    },
    {
      "name": "nativapp",
      "role": "mobile",
      "description": "Application React Native (Expo)",
      "install": true
    }
  ],
  "units": [
    {
      "name": "ms-user",
      "repo": "ms-user",
      "path": "ms-user",
      "kind": "microservice",
      "order": 10,
      "migrations": true,
      "certs": true
    },
    {
      "name": "ms-social",
      "repo": "ms-social",
      "path": "ms-social",
      "kind": "microservice",
      "order": 11,
      "migrations": true,
      "certs": true
    },
    {
      "name": "ms-post",
      "repo": "ms-post",
      "path": "ms-post",
      "kind": "microservice",
      "order": 12,
      "migrations": true,
      "certs": true
    },
    {
      "name": "ms-event",
      "repo": "ms-event",
      "path": "ms-event",
      "kind": "microservice",
      "order": 13,
      "migrations": true,
      "certs": true
    },
    {
      "name": "ms-storage",
      "repo": "ms-storage",
      "path": "ms-storage",
      "kind": "microservice",
      "order": 14,
      "migrations": true,
      "certs": true
    },
    {
      "name": "ms-ranking",
      "repo": "ms-ranking",
      "path": "ms-ranking",
      "kind": "microservice",
      "order": 15,
      "migrations": true,
      "certs": true
    },
    {
      "name": "api-gateway",
      "repo": "api-gateway",
