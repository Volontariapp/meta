      "order": 51
    },
    {
      "name": "worker-post",
      "repo": "workers-runners",
      "path": "workers-runners/worker-post",
      "kind": "worker",
      "order": 52
    },
    {
      "name": "worker-event",
      "repo": "workers-runners",
      "path": "workers-runners/worker-event",
      "kind": "worker",
      "order": 53
    },
    {
      "name": "worker-storage",
      "repo": "workers-runners",
      "path": "workers-runners/worker-storage",
      "kind": "worker",
      "order": 54
    },
    {
      "name": "worker-ranking",
      "repo": "workers-runners",
      "path": "workers-runners/worker-ranking",
      "kind": "worker",
      "order": 55
    },
    {
      "name": "nativapp",
      "repo": "nativapp",
      "path": "nativapp",
      "kind": "mobile",
      "order": 90
    }
  ],
  "profiles": {
    "backend-core": [
      "microservice",
      "gateway"
    ],
    "services": [
      "microservice"
    ],
    "outbox": [
      "outbox"
    ],
    "backend": [
      "microservice",
      "gateway",
      "outbox",
      "post-processor",
      "worker"
    ],
    "all-no-mobile": [
      "microservice",
      "gateway",
      "outbox",
      "post-processor",
      "worker"
    ],
    "all": [
      "microservice",
      "gateway",
      "outbox",
      "post-processor",
      "worker",
      "mobile"
    ]
  },
  "envs": {
    "local": "start:local",
    "dev": "start:dev",
    "test": "start:test",
    "prod": "start:prod"
  },
  "infra": {
    "compose": "ci-tools/docker-compose.yml",
    "services": [
      "postgres-user",
      "postgres-post",
      "postgres-event",
      "postgres-social",
      "postgres-ws",
      "postgres-storage",
      "postgres-ranking",
      "neo4j-social",
      "redis",
      "redis-ws-service",
      "minio"
    ],
    "init": [
      "minio-init"
    ],
    "optional": [
      "clamd"
    ]
  }
}
