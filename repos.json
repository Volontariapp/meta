      "kind": "outbox",
      "order": 36
    },
    {
      "name": "post-processor-user",
      "repo": "post-processors-runner",
      "path": "post-processors-runner/post-processor-user",
      "kind": "post-processor",
      "order": 40
    },
    {
      "name": "post-processor-social",
      "repo": "post-processors-runner",
      "path": "post-processors-runner/post-processor-social",
      "kind": "post-processor",
      "order": 41
    },
    {
      "name": "post-processor-post",
      "repo": "post-processors-runner",
      "path": "post-processors-runner/post-processor-post",
      "kind": "post-processor",
      "order": 42
    },
    {
      "name": "post-processor-event",
      "repo": "post-processors-runner",
      "path": "post-processors-runner/post-processor-event",
      "kind": "post-processor",
      "order": 43
    },
    {
      "name": "post-processor-storage",
      "repo": "post-processors-runner",
      "path": "post-processors-runner/post-processor-storage",
      "kind": "post-processor",
      "order": 44
    },
    {
      "name": "post-processor-ranking",
      "repo": "post-processors-runner",
      "path": "post-processors-runner/post-processor-ranking",
      "kind": "post-processor",
      "order": 45
    },
    {
      "name": "worker-user",
      "repo": "workers-runners",
      "path": "workers-runners/worker-user",
      "kind": "worker",
      "order": 50
    },
    {
      "name": "worker-social",
      "repo": "workers-runners",
      "path": "workers-runners/worker-social",
