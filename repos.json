    {
      "name": "outbox-user",
      "repo": "outbox-runners",
      "path": "outbox-runners/outbox-user",
      "kind": "outbox",
      "order": 30
    },
    {
      "name": "outbox-social",
      "repo": "outbox-runners",
      "path": "outbox-runners/outbox-social",
      "kind": "outbox",
      "order": 31
    },
    {
      "name": "outbox-post",
