    },
    {
      "name": "outbox-storage",
      "repo": "outbox-runners",
      "path": "outbox-runners/outbox-storage",
      "kind": "outbox",
      "order": 34
    },
    {
      "name": "outbox-ranking",
      "repo": "outbox-runners",
      "path": "outbox-runners/outbox-ranking",
      "kind": "outbox",
      "order": 35
    },
    {
      "name": "outbox-ws",
      "repo": "outbox-runners",
