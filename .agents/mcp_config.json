{
  "mcpServers": {
    "meta-indexer-local": {
      "command": "cargo",
      "args": ["run", "--release", "--manifest-path", "mcp-meta-indexer/Cargo.toml"],
      "env": {
        "MCP_TRANSPORT": "stdio"
      }
    },
    "meta-indexer-cluster": {
      "command": "kubectl",
      "args": [
        "exec",
        "-i",
        "deployment/mcp-meta-indexer",
        "-n",
        "prod",
        "-c",
        "mcp-meta-indexer",
        "--",
        "env",
        "MCP_TRANSPORT=stdio",
        "mcp-meta-indexer"
      ]
    }
  }
}
